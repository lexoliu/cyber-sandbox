# Generated by cyber-sandbox.
Port {{ ssh_port }}
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile {{ authorized_keys }}
AllowUsers {{ researcher_user }}
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
# `claude ssh` carries the model API back to the host over a remote-forwarded unix
# socket, so remote stream-local forwarding is the one forwarding mode that stays on.
AllowStreamLocalForwarding remote
PermitTunnel no
PrintMotd no
AcceptEnv LANG LC_* ANTHROPIC_* CLAUDE_CODE_* CODEX_*
